module

public import Mathlib.Algebra.Category.ModuleCat.Presheaf.Pushforward

/-!
# Pushforward simplification for presheaves of modules

Additions from `Brian-Nugent/mathlib4` at commit
`aa5bcdad6bf59fc419495240ce8a4a5a07abba06` (`Pic`), kept outside the mathlib dependency.
-/

@[expose] public section

universe v v₁ v₂ u₁ u₂ u

open CategoryTheory

namespace PresheafOfModules

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]

/-- The object-map simp lemma generated by `simps!` on the `Pic` branch. -/
@[simp]
lemma pushforward₀_obj_map (F : C ⥤ D) (R : Dᵒᵖ ⥤ RingCat.{u})
    (M : PresheafOfModules.{v} R) {X Y : Cᵒᵖ} (f : X ⟶ Y) :
    ((pushforward₀ F R).obj M).map f = M.map (F.map f.unop).op := rfl

end PresheafOfModules
